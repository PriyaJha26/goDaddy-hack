# Copy to .env and fill in. Never commit .env: it holds secrets.

# --- Site ---------------------------------------------------------------
ENVIRONMENT=development            # set to "production" on the server
DOMAIN=yourdomain.com              # used by Caddy for HTTPS
PUBLIC_BASE_URL=http://localhost:8000   # https://yourdomain.com in production
SITE_NAME=Open for Agents
SEED_DEMO_DATA=true

# --- Security -----------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
OWNER_PASSWORD=

# --- Claude (platform.claude.com → API keys) ------------------------------
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-sonnet-5-5
# REPLY_MODEL=claude-haiku-5-5
# SHOPPER_MODEL=claude-sonnet-5-5

# --- Email: your GoDaddy Titan mailbox -----------------------------------
# If login is rejected on smtp.titan.email, smtpout.secureserver.net usually works.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=hello@yourdomain.com
SMTP_PASSWORD=
NOTIFY_EMAIL=hello@yourdomain.com

# Local development behind a corporate TLS-inspecting proxy only:
# USE_SYSTEM_TRUSTSTORE=true
